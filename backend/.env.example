# PhishGuard Environment Variables (template)
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# ── Google OAuth 2.0 ──────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend origin (must match an Authorized JavaScript origin in GCP)
FRONTEND_URL=http://localhost:5173

# ── Application ───────────────────────────────────────────────────
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_UPLOAD_SIZE_MB=10

# ── AI Verification (OPTIONAL second opinion; app works fully without it) ──
# The deterministic rule engine is ALWAYS the primary analysis system.
#
# Hosted Groq API (no local model, no Ollama, nothing to install):
#   1. Get an API key: https://console.groq.com/keys
#   2. Uncomment the next four lines and fill in your key (server-side only,
#      never exposed to the frontend, never logged).
# AI_ENABLED=true
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AI_MODEL=openai/gpt-oss-120b
#
# Local model via Ollama (recommended if email data must never leave your machine):
#   1. Install Ollama: https://ollama.com/download
#   2. ollama pull llama3.2:3b
#   3. Uncomment the next three lines.
# PHISHGUARD_AI_PROVIDER=ollama
# PHISHGUARD_AI_ENDPOINT=http://localhost:11434
# PHISHGUARD_AI_MODEL=llama3.2:3b
#
# External OpenAI-compatible endpoint (optional alternative):
# PHISHGUARD_AI_PROVIDER=openai-compatible
# PHISHGUARD_AI_ENDPOINT=https://api.example.com
# PHISHGUARD_AI_API_KEY=...   (server-side only, never sent to the frontend)
#
# Timeout in seconds (default 60):
# PHISHGUARD_AI_TIMEOUT=60
